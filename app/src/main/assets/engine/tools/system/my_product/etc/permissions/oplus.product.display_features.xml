<oplus-config>
    <!-- brightness feature -->
    <oplus-feature name="oplus.software.display.screen_gloablehbm_support"/>
    <oplus-feature name="oplus.software.display.autobrightctl_animation_support"/>
    <oplus-feature name="oplus.software.display.multibits_dimming_support"/>
    <oplus-feature name="oplus.software.display.brightness_mode_automatic"/>
    <oplus-feature name="oplus.software.display.enhance_brightness_with_uidimming" />
    <!-- colormode feature -->
    <oplus-feature name="oplus.software.display.colormode_calibrate_support" />
    <oplus-feature name="oplus.software.display.colormode_support"/>
    <!-- colorball feature -->
    <oplus-feature name="oplus.software.display.rgb_ball_support" />
    <!-- Add for Game Color Enhance 2.0 -->
    <oplus-feature name="oplus.software.display.game_color_enhance_2.0"/>
    <!-- Add for Game Fliter 2.0 -->
    <oplus-feature name="oplus.software.display.game_filter_2.0"/>
    <!-- Add for display calbrication 100APL   -->
    <oplus-feature name="oplus.software.display.screen_calibrate_100apl"/>
    <!-- aod feature -->
    <oplus-feature name="oplus.software.display.aod_support"/>
    <oplus-feature name="oplus.software.display.aod_prevent_burn_support"/>
    <!-- sceen fingerprint feature -->
    <oplus-feature name="oplus.software.fingeprint_optical_enabled"/>
    <oplus-feature name="oplus.software.display.fingerprint_disable_dimlayer"/>
    <!-- eyeprotect feature-->
    <oplus-feature name="oplus.software.display.dual_sensor_support" />
    <oplus-feature name="oplus.software.display.intelligent_color_temperature_support" />
    <oplus-feature name="oplus.software.display.smart_color_temperature_rhythm_health_support" />
    <oplus-feature name="oplus.software.display.lock_color_temperature_in_drag_brightness_bar_support"/>
    <oplus-feature name="oplus.software.display.eyeprotect_with_upgrade_ui"/>
    <oplus-feature name="oplus.software.display.customize_comfortable_rhythm_support" />
    <oplus-feature name="oplus.software.display.screen_heteromorphism"/>
    <!-- AI eye protect 1.0 -->
    <oplus-feature name="oplus.software.display.ai_eyeprotect_v1_support"/>
    <!-- Add for game dark eyeprotect -->
    <oplus-feature name="oplus.software.display.game_dark_eyeprotect_support"/>
    <!-- Add for reduce white point -->
    <oplus-feature name="oplus.software.display.reduce_white_point"/>
    <!-- Add for resoultionsiwtch feature -->
    <oplus-feature name="oplus.software.display.resolution_switch_support" />
    <oplus-feature name="oplus.software.app_resolution_switch" />
    <!-- feature dsr -->
    <oplus-feature name="oplus.software.display.dsr_support"/>
    <oplus-feature name="oplus.software.fod_optical_enabled"/>
    <oplus-feature name="com.android.systemui.support_upgrade_anim_waterripple"/>
</oplus-config>
